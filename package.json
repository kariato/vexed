{
  "name": "vexed-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "typecheck": "tsc -b && tsc -p tsconfig.domain.json && tsc -p tsconfig.tests.json && tsc -p tsconfig.tools.json",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:reference": "vitest run tests/regression",
    "check": "npm run lint && npm run typecheck && npm test && npm run packs:check && npm run build",
    "packs:convert": "tsx scripts/convert-packs.ts",
    "packs:audit": "tsx scripts/audit-packs.ts",
    "packs:check": "npm run packs:convert -- --check && npm run packs:audit -- --check",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  },
  "license": "GPL-2.0-or-later",
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "packageManager": "npm@11.21.1"
}
